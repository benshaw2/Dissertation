<Group hide-output="false" labelreference="L104" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="M &gt; " style="Maple Input" layout="Normal">myDist:=proc(p,q,Ve,g,tee) 
local Q, vars, varsT, ip, ics, nsol, lefts, rights, idxs, ds, vec, gp, distsq;


Q:=DGinformation(g, &quot;ObjectFrame&quot;);
vars:=DGinformation(Q,&quot;FrameIndependentVariables&quot;);
varsT:=[seq(vars[i](tee),i=1..nops(vars))];

ip:=[seq(vars[i]=p[i],i=1..nops(vars))];
ics:=[seq(vars[i](0)=p[i],i=1..nops(vars)),seq(vars[i](1)=q[i],i=1..nops(vars))];
nsol:=dsolve(convert(ListTools:-FlattenOnce([Ve,ics]),set),convert(varsT,set),numeric,maxmesh=4096);
lefts:=[seq(lhs(nsol(0)[i]),i=1..nops(nsol(0)))];
rights:=[seq(rhs(nsol(0)[i]),i=1..nops(nsol(0)))];

idxs:=[seq(ListTools:-Search(diff(varsT[i],tee),lefts),i=1..nops(varsT))];
ds:=[seq(rights[idxs[i]],i=1..nops(idxs))];

vec:=DGzip(ds,DGinformation(Q,&quot;FrameBaseVectors&quot;),&quot;plus&quot;);
gp:=eval(g,ip);
distsq:=ContractIndices(gp,vec &amp;t vec, [[1,1],[2,2]]);
sqrt(distsq);
end:</Text-field>
</Input>
</Group>
