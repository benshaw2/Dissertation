</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LCQqKi1JJGV4cEc2JCUqcHJvdGVjdGVkR0koX3N5c2xpYkc2IjYjLCoqJEkieEdGJyIiIyEiIiokSSJ5R0YnRi4jRi9GLiomRjEiIiJJInpHRidGNEY0KiRGNUYuRjJGNCwmRjFGNEY1RjRGNCwqKiZJImFHRilGNEYxRjRGNComRjpGNEY1RjRGLyomSSJiR0YpRjRGLUY0RjQqJkkiY0dGKUY0Ri1GNEY0RjQsJkY0RjRGJEY0ISIjRjI=</Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" hide-output="false" labelreference="L301" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
